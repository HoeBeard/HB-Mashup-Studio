{
  "name": "hb-mashup-studio",
  "productName": "HB Mashup Studio",
  "version": "1.0.0",
  "description": "Easy mashup and performance-mix maker by HB Software",
  "author": "HB Software",
  "homepage": "https://hbcs.info",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "test": "node test/engine.test.js",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "check": "node scripts/check.js"
  },
  "build": {
    "appId": "info.hbcs.mashupstudio",
    "productName": "HB Mashup Studio",
    "copyright": "Copyright © 2026 HB Software",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/logo.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HB Mashup Studio",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "HB-Mashup-Studio-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/logo.png",
      "category": "public.app-category.music",
      "artifactName": "HB-Mashup-Studio-Mac.${ext}",
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/logo.png",
      "category": "Audio"
    },
    "icon": "src/assets/logo.png",
    "dmg": {
      "title": "HB Mashup Studio",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "lamejs": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  }
}
